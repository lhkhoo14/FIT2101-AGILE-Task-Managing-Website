# Supabase: Project Settings > Database > Connection string > Session pooler
# Replace the placeholders locally. Never commit a real password or token.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5500

# Email delivery. The API sends through Brevo's HTTPS API rather than SMTP
# because Render's free web services block outbound traffic to the SMTP ports
# (25, 465, 587). Leave BREVO_API_KEY empty to have messages written to the log
# instead of sent - that is what happens locally and in the test suites.
# MAIL_FROM must be a sender address verified under Brevo > Senders.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# Base URL used to build verification links. No trailing slash needed.
FRONTEND_URL=http://localhost:5500
